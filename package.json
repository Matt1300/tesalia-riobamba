{
  "name": "tesalia-riobamba",
  "version": "0.1.0",
  "description": "Sistema de control de pagos por rutas de camiones - Tesalia Riobamba",
  "private": true,
  "scripts": {
    "build":   "tsc && cp src/appsscript.json dist/ && cp -r src/views dist/",
    "push":    "npm run build && clasp push --force",
    "pull":    "clasp pull",
    "version": "clasp version create",
    "release": "npm run push && clasp deploy --deploymentId AKfycbzoBVE0VBy-p3ftt-CIS-G4LR3lTFwVavu1YjPe7r6bNv2r91KcoEBGYya3vW5hGSjDWA",
    "typecheck": "tsc --noEmit",
    "watch":   "tsc --watch"
  },
  "devDependencies": {
    "@types/google-apps-script": "^1.0.83",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0"
  }
}
